{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>apeiros-innovations/renovate-presets#main", ":timezone(America/New_York)"],
  // Generated tool selections are refreshed from .config/mise.toml.
  "packageRules": [
    {
      "matchFileNames": ["mise/github.toml"],
      "enabled": false,
    },
  ],
}
