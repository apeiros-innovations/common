{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>apeiros-innovations/renovate-presets#main", ":timezone(America/New_York)"],
  "packageRules": [
    {
      "description": "Use published Helm Docs releases instead of historical date tags",
      "matchManagers": ["mise"],
      "matchPackageNames": ["norwoodj/helm-docs"],
      "overrideDatasource": "github-releases",
    },
  ],
}
