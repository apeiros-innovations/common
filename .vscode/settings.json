{
  "editor.bracketPairColorization.enabled": true,
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "yaml.schemaStore.enable": true,
  "json.schemaDownload.enable": true,
  "markdownlint.configFile": ".markdownlint.yaml",
  "prettier.ignorePath": ".prettierignore",
  "files.associations": {
    "kics.config": "yaml",
    "**/*.yaml": "yaml",
    "**/*.yml": "yaml",
    "**/*.toml": "toml",
    "fnox.toml": "toml",
    "CODEOWNERS": "txt",
    "**/*.json5": "json5",
    ".markdownlintignore": "ignore",
    ".prettierignore": "ignore",
    ".trivyignore": "ignore"
  },

  "yaml.customTags": ["!reference sequence"],

  "yaml.schemas": {
    "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json": "**/.cspell.yaml"
  },

  "json.schemas": [
    {
      "fileMatch": ["mise.toml", ".mise.toml", "config.toml" ],
      "url": "https://mise.jdx.dev/schema/mise.json"
    }
  ]
}
