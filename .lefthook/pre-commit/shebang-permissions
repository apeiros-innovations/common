#!/usr/bin/env bash

set -euo pipefail

failed=0

for file in "$@"; do
  entry="$(
    git ls-files \
      --cached \
      --format='%(stage)%x09%(objectmode)%x09%(objectname)' \
      -- "$file"
  )"

  [[ -n "$entry" ]] || continue

  if [[ "$entry" == *$'\n'* ]]; then
    printf >&2 \
      '%s: index contains multiple stages; resolve the conflict before checking permissions\n' \
      "$file"
    failed=1
    continue
  fi

  IFS=$'\t' read -r stage mode oid <<<"$entry"

  if [[ "$stage" != "0" ]]; then
    printf >&2 \
      '%s: index entry is at stage %s; resolve the conflict before checking permissions\n' \
      "$file" \
      "$stage"
    failed=1
    continue
  fi

  case "$mode" in
    100644 | 100755)
      ;;
    *)
      continue
      ;;
  esac

  prefix=""

  IFS= read -r -n 2 prefix < <(
    git cat-file blob "$oid"
  ) || true

  if [[ "$prefix" == "#!" ]]; then
    if [[ "$mode" == "100644" ]]; then
      printf >&2 \
        '%s:1: shebang script has index mode 100644; setting executable mode 100755\n' \
        "$file"

      [[ -f "$file" ]] && chmod +x -- "$file"
      git update-index --chmod=+x -- "$file"
    fi

    continue
  fi

  if [[ "$mode" == "100755" ]]; then
    printf >&2 \
      '%s:1: executable text file has index mode 100755 but does not begin with a shebang\n' \
      "$file"

    failed=1
  fi
done

exit "$failed"
