#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &&
    pwd -P
)"

# shellcheck source=../lib/common.sh
source "${SCRIPT_DIR}/../lib/common.sh"

REPOSITORY_ROOT="$(git rev-parse --show-toplevel)"
REMOTE_ROOT="$(common_remote_root)"

readonly REPOSITORY_ROOT
readonly REMOTE_ROOT

die() {
  printf 'oxfmt: %s\n' "$*" >&2
  exit 1
}

resolve_config_path() {
  local config=$1

  if [[ $config == /* ]]; then
    printf '%s\n' "$config"
  else
    printf '%s/%s\n' "$REPOSITORY_ROOT" "$config"
  fi
}

repository_has_config() {
  local path

  while IFS= read -r -d '' path; do
    [[ -n $path ]] && return 0
  done < <(
    git -C "$REPOSITORY_ROOT" ls-files \
      --cached \
      --others \
      --exclude-standard \
      -z \
      -- \
      '.oxfmtrc.json' \
      '.oxfmtrc.jsonc' \
      'oxfmt.config.ts' \
      'oxfmt.config.mts' \
      ':(glob)**/.oxfmtrc.json' \
      ':(glob)**/.oxfmtrc.jsonc' \
      ':(glob)**/oxfmt.config.ts' \
      ':(glob)**/oxfmt.config.mts'
  )

  return 1
}

resolve_shared_config() {
  first_existing_file \
    "${REMOTE_ROOT}/.oxfmtrc.json" \
    "${REMOTE_ROOT}/.oxfmtrc.jsonc" \
    "${REMOTE_ROOT}/oxfmt.config.ts" \
    "${REMOTE_ROOT}/oxfmt.config.mts" ||
    die "unable to locate shared Oxfmt configuration"
}

main() {
  local config

  cd -- "$REPOSITORY_ROOT"

  if [[ -n ${OXFMT_CONFIG:-} ]]; then
    config="$(resolve_config_path "$OXFMT_CONFIG")"
    [[ -f $config ]] || die "configuration not found: ${config}"

    exec mise x -- oxfmt --config "$config" -- "$@"
  fi

  if repository_has_config; then
    exec mise x -- oxfmt -- "$@"
  fi

  config="$(resolve_shared_config)"

  exec mise x -- oxfmt --config "$config" -- "$@"
}

main "$@"
