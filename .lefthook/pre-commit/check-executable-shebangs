#!/usr/bin/env bash

set -euo pipefail

failed=0

for file in "$@"; do
  mode="$(git ls-files --stage -- "$file" | awk 'NR == 1 { print $1 }')"
  [[ "$mode" == "100755" ]] || continue

  prefix="$(git show ":$file" 2>/dev/null | LC_ALL=C head -c 2)"
  if [[ "$prefix" != "#!" ]]; then
    printf '%s: executable file has no shebang\n' "$file" >&2
    failed=1
  fi
done

exit "$failed"
