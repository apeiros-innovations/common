#!/usr/bin/env bash

set -euo pipefail

failed=0

for file in "$@"; do
  if git diff --cached --quiet --diff-filter=A -- "$file"; then
    continue
  fi

  lfs_attr="$(git check-attr filter -- "$file")"
  case "$lfs_attr" in
    *": filter: lfs") continue ;;
  esac

  size="$(git cat-file -s ":$file")"
  if [[ "$size" -gt 1048576 ]]; then
    kib=$(((size + 1023) / 1024))
    printf '%s (%s KiB) exceeds the 1024 KiB limit\n' "$file" "$kib" >&2
    failed=1
  fi
done

exit "$failed"
