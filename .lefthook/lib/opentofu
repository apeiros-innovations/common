#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(
	cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &&
		pwd -P
)"

# shellcheck source=common.sh
source "${SCRIPT_DIR}/common.sh"

REPOSITORY_ROOT="$(git rev-parse --show-toplevel)"
REMOTE_ROOT="$(common_remote_root)"

readonly REPOSITORY_ROOT
readonly REMOTE_ROOT

readonly -a PROVIDER_PLATFORMS=(
	"-platform=darwin_arm64"
	"-platform=linux_amd64"
)

declare -a MODULE_DIRECTORIES=()

die() {
	printf 'opentofu: %s\n' "$*" >&2
	exit 1
}

absolute_file() {
	local path=$1
	local directory
	local filename

	directory="$(dirname -- "$path")"
	filename="$(basename -- "$path")"

	(
		cd -- "$directory"
		printf '%s/%s\n' "$(pwd -P)" "$filename"
	)
}

add_unique_directory() {
	local candidate=$1
	local existing

	for existing in "${MODULE_DIRECTORIES[@]:-}"; do
		[[ -n $existing ]] ||
			continue

		[[ $existing == "$candidate" ]] &&
			return 0
	done

	MODULE_DIRECTORIES+=("$candidate")
}

module_has_configuration() {
	local directory=$1

	find "$directory" \
		-maxdepth 1 \
		-type f \
		\( \
		-name '*.tf' -o \
		-name '*.tofu' -o \
		-name '*.tf.json' -o \
		-name '*.tofu.json' \
		\) \
		-print \
		-quit |
		grep -q .
}

collect_module_directories() {
	local path
	local directory

	MODULE_DIRECTORIES=()

	for path in "$@"; do
		case "$path" in
		*.tf | \
			*.tofu | \
			*.tf.json | \
			*.tofu.json | \
			*.tfvars | \
			*.tfvars.json | \
			*.tftest.hcl | \
			*.tofutest.hcl | \
			*.tfmock.hcl | \
			*.tfquery.hcl | \
			*/.terraform.lock.hcl | \
			.terraform.lock.hcl)
			;;
		*)
			continue
			;;
		esac

		case "/${path}/" in
		*/.terraform/*)
			continue
			;;
		esac

		directory="$(dirname -- "$path")"

		[[ -d $directory ]] ||
			continue

		module_has_configuration "$directory" ||
			continue

		add_unique_directory "$directory"
	done
}

guard_generated_file() {
	local path=$1

	[[ -e $path ]] ||
		return 0

	if ! git ls-files --error-unmatch -- "$path" >/dev/null 2>&1; then
		die "${path}: refusing to overwrite an existing untracked file"
	fi

	if ! git diff --quiet -- "$path"; then
		die "${path}: refusing to overwrite unstaged changes"
	fi
}

guard_lockfile() {
	local path=$1

	[[ -e $path ]] ||
		return 0

	# A new untracked lockfile may become a managed generated artifact.
	# Existing tracked lockfiles with unstaged developer changes must not
	# be overwritten.
	if git ls-files --error-unmatch -- "$path" >/dev/null 2>&1 &&
		! git diff --quiet -- "$path"; then
		die "${path}: refusing to overwrite unstaged changes"
	fi
}

module_owns_lockfile() {
	local module=$1
	local lockfile="${module}/.terraform.lock.hcl"

	# The repository root is treated as an explicit OpenTofu root
	# configuration when this profile is selected.
	if [[ $module == "." ]]; then
		return 0
	fi

	# A nested configuration owns a dependency lockfile only when that
	# ownership has already been made explicit by the presence of one.
	#
	# This prevents reusable child modules from receiving lockfiles merely
	# because their source files were changed.
	[[ -e $lockfile ]]
}

resolve_terraform_docs_config() {
	local module=$1
	local config

	config="$(
		first_existing_file \
			"${module}/.terraform-docs.yaml" \
			"${module}/.terraform-docs.yml" \
			"${REPOSITORY_ROOT}/.terraform-docs.yaml" \
			"${REPOSITORY_ROOT}/.terraform-docs.yml" \
			"${REMOTE_ROOT}/.terraform-docs.yaml" \
			"${REMOTE_ROOT}/.terraform-docs.yml"
	)" ||
		die "unable to locate terraform-docs configuration"

	absolute_file "$config"
}

resolve_tflint_config() {
	local module=$1
	local config

	config="$(
		first_existing_file \
			"${module}/.tflint.hcl" \
			"${module}/.tflint.json" \
			"${REPOSITORY_ROOT}/.tflint.hcl" \
			"${REPOSITORY_ROOT}/.tflint.json" \
			"${REMOTE_ROOT}/.tflint.hcl"
	)" ||
		die "unable to locate TFLint configuration"

	absolute_file "$config"
}

resolve_trivy_config() {
	local module=$1
	local config

	config="$(
		first_existing_file \
			"${module}/.trivy.yaml" \
			"${module}/.trivy.yml" \
			"${REPOSITORY_ROOT}/.trivy.yaml" \
			"${REPOSITORY_ROOT}/.trivy.yml"
	)" || return 1

	absolute_file "$config"
}

format_files() {
	local file
	local failed=0

	for file in "$@"; do
		[[ -f $file ]] ||
			continue

		case "$file" in
		*.tf | \
			*.tofu | \
			*.tfvars | \
			*.tftest.hcl | \
			*.tofutest.hcl | \
			*.tfmock.hcl | \
			*.tfquery.hcl)
			;;
		*)
			continue
			;;
		esac

		case "/${file}/" in
		*/.terraform/*)
			continue
			;;
		esac

		printf 'formatting OpenTofu: %s\n' "$file"

		tofu fmt "$file" ||
			failed=1
	done

	return "$failed"
}

generate_docs() {
	local module
	local config
	local readme
	local failed=0

	collect_module_directories "$@"

	for module in "${MODULE_DIRECTORIES[@]:-}"; do
		[[ -n $module ]] ||
			continue

		config="$(resolve_terraform_docs_config "$module")"
		readme="${module}/README.md"

		guard_generated_file "$readme"

		printf 'generating OpenTofu documentation: %s\n' "$module"

		(
			cd -- "$module"

			terraform-docs \
				--config "$config" \
				.
		) || {
			failed=1
			continue
		}

		if [[ -f $readme ]]; then
			git add -- "$readme"
		fi
	done

	return "$failed"
}

providers_lock() {
	local module
	local lockfile
	local data_dir
	local status
	local failed=0

	collect_module_directories "$@"

	for module in "${MODULE_DIRECTORIES[@]:-}"; do
		[[ -n $module ]] ||
			continue

		if ! module_owns_lockfile "$module"; then
			printf \
				'opentofu: skipping provider lock for %s; nested configurations must explicitly own a .terraform.lock.hcl before the shared hook manages it\n' \
				"$module"
			continue
		fi

		lockfile="${module}/.terraform.lock.hcl"

		guard_lockfile "$lockfile"

		printf 'locking OpenTofu providers: %s\n' "$module"

		data_dir="$(
			mktemp -d \
				"${TMPDIR:-/tmp}/opentofu-lock.XXXXXX"
		)"

		status=0

		TF_DATA_DIR="$data_dir" \
			tofu \
			-chdir="$module" \
			init \
			-backend=false \
			-input=false \
			-no-color ||
			status=$?

		if ((status == 0)); then
			TF_DATA_DIR="$data_dir" \
				tofu \
				-chdir="$module" \
				providers \
				lock \
				"${PROVIDER_PLATFORMS[@]}" ||
				status=$?
		fi

		rm -rf -- "$data_dir"

		if ((status != 0)); then
			printf \
				'opentofu: provider lock failed for %s with exit status %d\n' \
				"$module" \
				"$status" >&2

			failed=1
			continue
		fi

		if [[ -f $lockfile ]]; then
			git add -- "$lockfile"
		fi
	done

	return "$failed"
}

lint_modules() {
	local module
	local config
	local failed=0

	collect_module_directories "$@"

	for module in "${MODULE_DIRECTORIES[@]:-}"; do
		[[ -n $module ]] ||
			continue

		config="$(resolve_tflint_config "$module")"

		printf 'linting OpenTofu module: %s\n' "$module"

		tflint \
			--chdir="$module" \
			--config="$config" ||
			failed=1
	done

	return "$failed"
}

scan_modules() {
	local module
	local config
	local failed=0

	collect_module_directories "$@"

	for module in "${MODULE_DIRECTORIES[@]:-}"; do
		[[ -n $module ]] ||
			continue

		printf 'scanning OpenTofu module: %s\n' "$module"

		if config="$(resolve_trivy_config "$module")"; then
			(
				cd -- "$module"

				trivy config \
					--quiet \
					--exit-code 1 \
					--skip-dirs .terraform \
					--config "$config" \
					.
			) || failed=1
		else
			(
				cd -- "$module"

				trivy config \
					--quiet \
					--exit-code 1 \
					--skip-dirs .terraform \
					.
			) || failed=1
		fi
	done

	return "$failed"
}

validate_initialized_module() {
	local module=$1
	local data_dir
	local status=0
	local had_lockfile=false

	local -a init_args=(
		init
		-backend=false
		-input=false
		-no-color
	)

	if [[ -e "${module}/.terraform.lock.hcl" ]]; then
		had_lockfile=true
		init_args+=("-lockfile=readonly")
	fi

	data_dir="$(
		mktemp -d \
			"${TMPDIR:-/tmp}/opentofu-validate.XXXXXX"
	)"

	TF_DATA_DIR="$data_dir" \
		tofu \
		-chdir="$module" \
		"${init_args[@]}" ||
		status=$?

	if ((status == 0)); then
		TF_DATA_DIR="$data_dir" \
			tofu \
			-chdir="$module" \
			validate \
			-no-color ||
			status=$?
	fi

	rm -rf -- "$data_dir"

	# OpenTofu stores provider/module installation data under TF_DATA_DIR,
	# but the dependency lockfile remains in the configuration directory.
	# Remove a lockfile created solely for transient validation when this
	# module did not own one before initialization.
	if [[ $had_lockfile == false ]]; then
		rm -f -- "${module}/.terraform.lock.hcl"
	fi

	return "$status"
}

validate_modules() {
	local module
	local failed=0

	collect_module_directories "$@"

	for module in "${MODULE_DIRECTORIES[@]:-}"; do
		[[ -n $module ]] ||
			continue

		printf 'validating OpenTofu module: %s\n' "$module"

		# Prefer already-initialized state. This avoids unnecessary provider
		# installation during normal development when the configuration can
		# already be validated.
		if tofu \
			-chdir="$module" \
			validate \
			-no-color; then
			continue
		fi

		printf \
			'opentofu: validation requires initialization; initializing transiently without backend: %s\n' \
			"$module" >&2

		if ! validate_initialized_module "$module"; then
			printf \
				'opentofu: validation failed: %s\n' \
				"$module" >&2

			failed=1
		fi
	done

	return "$failed"
}

usage() {
	cat >&2 <<'EOF'
usage: opentofu <command> [files...]

commands:
  fmt
  docs
  providers-lock
  tflint
  trivy
  validate
EOF
}

main() {
	local command=${1:-}

	[[ -n $command ]] || {
		usage
		exit 2
	}

	shift

	case "$command" in
	fmt)
		format_files "$@"
		;;
	docs)
		generate_docs "$@"
		;;
	providers-lock)
		providers_lock "$@"
		;;
	tflint)
		lint_modules "$@"
		;;
	trivy)
		scan_modules "$@"
		;;
	validate)
		validate_modules "$@"
		;;
	*)
		usage
		exit 2
		;;
	esac
}

main "$@"
