#!/usr/bin/env bash

set -euo pipefail

readonly -a PROVIDER_PLATFORMS=(
	"-platform=darwin_arm64"
	"-platform=linux_amd64"
)

declare -a DIRECTORIES=()

export TG_NON_INTERACTIVE=true

die() {
	printf 'terragrunt: %s\n' "$*" >&2
	exit 1
}

add_unique_directory() {
	local candidate=$1
	local existing

	for existing in "${DIRECTORIES[@]:-}"; do
		[[ -n $existing ]] ||
			continue

		[[ $existing == "$candidate" ]] &&
			return 0
	done

	DIRECTORIES+=("$candidate")
}

is_terragrunt_hcl_file() {
	local path=$1

	[[ $path == *.hcl ]] ||
		return 1

	# These HCL files belong to OpenTofu/TFLint rather than Terragrunt.
	case "$path" in
	*.tftest.hcl | \
		*.tofutest.hcl | \
		*.tfmock.hcl | \
		*.tfquery.hcl | \
		*/.terraform.lock.hcl | \
		.terraform.lock.hcl | \
		*/.tflint.hcl | \
		.tflint.hcl)
		return 1
		;;
	esac

	case "/${path}/" in
	*/.terraform/* | */.terragrunt-cache/*)
		return 1
		;;
	esac

	return 0
}

collect_hcl_directories() {
	local path
	local directory

	DIRECTORIES=()

	for path in "$@"; do
		is_terragrunt_hcl_file "$path" ||
			continue

		directory="$(dirname -- "$path")"

		[[ -d $directory ]] ||
			continue

		add_unique_directory "$directory"
	done
}

collect_unit_directories() {
	local path
	local directory

	DIRECTORIES=()

	for path in "$@"; do
		case "$path" in
		terragrunt.hcl | */terragrunt.hcl)
			directory="$(dirname -- "$path")"
			;;
		.terraform.lock.hcl | */.terraform.lock.hcl)
			directory="$(dirname -- "$path")"
			;;
		*)
			continue
			;;
		esac

		[[ -f "${directory}/terragrunt.hcl" ]] ||
			continue

		add_unique_directory "$directory"
	done
}

directory_has_opentofu_configuration() {
	local directory=$1

	find "$directory" \
		-maxdepth 1 \
		-type f \
		\( \
		-name '*.tf' -o \
		-name '*.tofu' -o \
		-name '*.tf.json' -o \
		-name '*.tofu.json' \
		\) \
		-print \
		-quit |
		grep -q .
}

guard_lockfile() {
	local path=$1

	[[ -e $path ]] ||
		return 0

	# New/untracked lockfiles are allowed to become managed artifacts.
	# Existing tracked lockfiles with unstaged developer changes are not
	# overwritten.
	if git ls-files --error-unmatch -- "$path" >/dev/null 2>&1 &&
		! git diff --quiet -- "$path"; then
		die "${path}: refusing to overwrite unstaged changes"
	fi
}

format_files() {
	local file
	local failed=0

	for file in "$@"; do
		[[ -f $file ]] ||
			continue

		is_terragrunt_hcl_file "$file" ||
			continue

		printf 'formatting Terragrunt HCL: %s\n' "$file"

		terragrunt hcl fmt \
			--file="$file" ||
			failed=1
	done

	return "$failed"
}

validate_hcl() {
	local directory
	local failed=0

	collect_hcl_directories "$@"

	for directory in "${DIRECTORIES[@]:-}"; do
		[[ -n $directory ]] ||
			continue

		printf 'validating Terragrunt HCL: %s\n' "$directory"

		(
			cd -- "$directory"
			terragrunt hcl validate
		) || failed=1
	done

	return "$failed"
}

validate_inputs() {
	local directory
	local failed=0

	collect_hcl_directories "$@"

	for directory in "${DIRECTORIES[@]:-}"; do
		[[ -n $directory ]] ||
			continue

		printf 'validating Terragrunt inputs: %s\n' "$directory"

		(
			cd -- "$directory"
			terragrunt hcl validate --inputs
		) || failed=1
	done

	return "$failed"
}

providers_lock() {
	local directory
	local lockfile
	local failed=0

	collect_unit_directories "$@"

	for directory in "${DIRECTORIES[@]:-}"; do
		[[ -n $directory ]] ||
			continue

		# When Terragrunt and native OpenTofu configuration coexist in the
		# same directory, OpenTofu owns the dependency lockfile. This avoids
		# two independent hooks racing to regenerate the same artifact.
		if directory_has_opentofu_configuration "$directory"; then
			printf \
				'terragrunt: skipping provider lock for %s; native OpenTofu configuration owns this lockfile\n' \
				"$directory"
			continue
		fi

		lockfile="${directory}/.terraform.lock.hcl"

		guard_lockfile "$lockfile"

		printf 'locking Terragrunt providers: %s\n' "$directory"

		if ! (
			cd -- "$directory"

			terragrunt run -- \
				providers lock \
				"${PROVIDER_PLATFORMS[@]}"
		); then
			failed=1
			continue
		fi

		if [[ -f $lockfile ]]; then
			git add -- "$lockfile"
		fi
	done

	return "$failed"
}

usage() {
	cat >&2 <<'EOF'
usage: terragrunt <command> [files...]

commands:
  fmt
  validate
  validate-inputs
  providers-lock
EOF
}

main() {
	local command=${1:-}

	[[ -n $command ]] || {
		usage
		exit 2
	}

	shift

	case "$command" in
	fmt)
		format_files "$@"
		;;
	validate)
		validate_hcl "$@"
		;;
	validate-inputs)
		validate_inputs "$@"
		;;
	providers-lock)
		providers_lock "$@"
		;;
	*)
		usage
		exit 2
		;;
	esac
}

main "$@"
