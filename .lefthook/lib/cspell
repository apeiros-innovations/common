#!/usr/bin/env bash
# NOTE: This is used by both pre-commit and pre-push hooks.

set -euo pipefail

SCRIPT_DIR="$(
  cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &&
    pwd -P
)"

# shellcheck source=common.sh
source "${SCRIPT_DIR}/common.sh"

REPOSITORY_ROOT="$(git rev-parse --show-toplevel)"
REMOTE_ROOT="$(common_remote_root)"

readonly REPOSITORY_ROOT
readonly REMOTE_ROOT

readonly -a CSPELL_CONFIG_NAMES=(
  ".cspell.config.yaml"
  ".cspell.config.yml"
  "cspell.config.yaml"
  "cspell.config.yml"
  ".cspell.yaml"
  ".cspell.yml"
  "cspell.yaml"
  "cspell.yml"
  ".cspell.json"
  "cspell.json"
  ".cSpell.json"
  "cSpell.json"
  ".cspell.jsonc"
  "cspell.jsonc"
  ".cspell.config.json"
  ".cspell.config.jsonc"
  "cspell.config.json"
  "cspell.config.jsonc"
  "cspell.config.mjs"
  "cspell.config.cjs"
  "cspell.config.js"
  ".cspell.config.mjs"
  ".cspell.config.cjs"
  ".cspell.config.js"
  "cspell.config.mts"
  "cspell.config.ts"
  "cspell.config.cts"
  ".cspell.config.mts"
  ".cspell.config.ts"
  ".cspell.config.cts"
  "cspell.config.toml"
  ".cspell.config.toml"
)

die() {
  printf 'cspell: %s\n' "$*" >&2
  exit 1
}

resolve_config_path() {
  local config=$1

  if [[ $config == /* ]]; then
    printf '%s\n' "$config"
  else
    printf '%s/%s\n' "$REPOSITORY_ROOT" "$config"
  fi
}

resolve_shared_config() {
  local config="${REMOTE_ROOT}/.cspell.yaml"
  [[ -f $config ]] || die "shared configuration not found: ${config}"
  printf '%s\n' "$config"
}

resolve_repository_config() {
  local directory
  local name
  local config
  local -a configs=()

  for directory in "$REPOSITORY_ROOT" "${REPOSITORY_ROOT}/.config"; do
    for name in "${CSPELL_CONFIG_NAMES[@]}"; do
      config="${directory}/${name}"
      [[ ! -f $config ]] || configs+=("$config")
    done
  done

  for name in cspell.json cSpell.json .cspell.json; do
    config="${REPOSITORY_ROOT}/.vscode/${name}"
    [[ ! -f $config ]] || configs+=("$config")
  done

  if [[ -f ${REPOSITORY_ROOT}/package.json ]]; then
    # Only a real top-level CSpell setting makes package.json a config.
    # A dependency named cspell must not change configuration discovery.
    local has_config
    has_config="$(mise x -- node -e '
      const fs = require("node:fs");
      const pkg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      process.stdout.write(String(Object.hasOwn(pkg, "cspell")));
    ' "${REPOSITORY_ROOT}/package.json")" || return "$?"
    [[ $has_config != true ]] || configs+=("${REPOSITORY_ROOT}/package.json")
  fi

  if ((${#configs[@]} > 1)); then
    printf 'cspell: multiple project configurations found:\n' >&2
    printf '  %s\n' "${configs[@]}" >&2
    die "keep one project config and import other settings, or set CSPELL_CONFIG to the intended file"
  fi

  if ((${#configs[@]} == 1)); then
    printf '%s\n' "${configs[0]}"
  fi
}

resolve_config() {
  local config

  if [[ -n ${CSPELL_CONFIG:-} ]]; then
    config="$(resolve_config_path "$CSPELL_CONFIG")"
    [[ -f $config ]] || die "configuration not found: ${config}"
    printf '%s\n' "$config"
    return 0
  fi

  config="$(resolve_repository_config)" || return "$?"
  if [[ -n $config ]]; then
    printf '%s\n' "$config"
  else
    resolve_shared_config
  fi
}

run_cspell() {
  local config=$1

  shift

  local -a command=(
    mise x -- cspell lint
    --config "$config"
    --gitignore
    --gitignore-root "$REPOSITORY_ROOT"
    --no-progress
    --no-must-find-files
  )

  if [[ -n ${CSPELL_CONFIG:-} || $config != "$REPOSITORY_ROOT/"* ]]; then
    # With a shared fallback there is no project config to stop discovery.
    # CSpell 10.2.1 does not apply --stop-config-search-at to document lookup.
    command+=(--no-config-search)
  else
    command+=(--stop-config-search-at "$REPOSITORY_ROOT")
  fi

  # Explicit files preserve literal names (including glob characters).
  # Prefix relative paths so a filename beginning with '-' is not an option.
  local file
  for file in "$@"; do
    [[ $file == /* ]] || file="./${file}"
    command+=(--file "$file")
  done

  exec "${command[@]}"
}

main() {
  local config

  (($# > 0)) || return 0
  cd -- "$REPOSITORY_ROOT"
  config="$(resolve_config)"
  run_cspell "$config" "$@"
}

main "$@"
